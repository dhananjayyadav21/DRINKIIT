
# Server
PORT=3000

# WhatsApp provider switch (set exactly one to true)
WHATSAPP_META_CLOUD_API=false
WHATSAPP_TWILIO=true

# WhatsApp via Meta Cloud API
WHATSAPP_TOKEN=your_meta_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_VERIFY_TOKEN=choose_any_random_string
WHATSAPP_API_VERSION=v20.0

# WhatsApp via Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_VALIDATE_SIGNATURE=true

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Business info
BUSINESS_NAME=DRINK IT
FREE_DELIVERY_RADIUS_KM=5
# Customer-facing number for the website's "Chat on WhatsApp" links, digits only with country code
BUSINESS_WHATSAPP_NUMBER=919082814100
# Contact details shown on the website (footer / About / Privacy)
BUSINESS_CONTACT_PHONE=9219029127
BUSINESS_CONTACT_EMAIL=drinkit9111@gmail.com
BUSINESS_ADDRESS=Sheetalganj, Jaunpur Bhadohi Road, Mariahu, Jaunpur, Uttar Pradesh – 222161

# Admin dashboard (/admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose_a_strong_password

# MongoDB (Atlas connection string)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/
MONGODB_DB_NAME=drinkit
