
# Server

PORT=3000

# Customer and order data is stored as JSON files on disk under
# src/data/files/ - no database setup or connection string needed.


# WhatsApp provider switch

# Set EXACTLY ONE of these to "true" and the other to "false". Setting both to
# the same value (both true, or both false) makes the server refuse to start.
WHATSAPP_META_CLOUD_API=false
WHATSAPP_TWILIO=true


# WhatsApp via Meta Cloud API (used when WHATSAPP_META_CLOUD_API=true)

# Permanent access token for your WhatsApp Business app (System User token)
WHATSAPP_TOKEN=your_meta_permanent_access_token
# Phone Number ID from WhatsApp > API Setup in the Meta App Dashboard
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
# Any random string you choose yourself - used to verify the webhook with Meta
WHATSAPP_VERIFY_TOKEN=choose_any_random_string
# Graph API version (optional, defaults to v20.0)
WHATSAPP_API_VERSION=v20.0


# WhatsApp via Twilio (used when WHATSAPP_TWILIO=true)

# From the Twilio Console dashboard
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Sandbox number (for testing, join code required): whatsapp:+14155238886
# Production: your own Twilio WhatsApp-enabled number, e.g. whatsapp:+91XXXXXXXXXX
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# ContentSid of a Content Template with a single {{1}} variable (Content Template
# Builder in Console -> Products & Services -> Templates). Save as draft, no need
# to submit for WhatsApp approval since we only send within the 24h session window.
TWILIO_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Set to "false" to skip Twilio signature validation (e.g. behind a dev ngrok tunnel)
TWILIO_VALIDATE_SIGNATURE=true


# Razorpay

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Secret you set when creating the webhook in the Razorpay Dashboard
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret


# Business info

BUSINESS_NAME=DRINK IT
FREE_DELIVERY_RADIUS_KM=5
